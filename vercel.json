{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/industries/index.html", "destination": "/services", "statusCode": 301 },
    { "source": "/industries/manufacturing", "destination": "/services", "statusCode": 301 },
    { "source": "/industries/real-estate", "destination": "/services", "statusCode": 301 },
    { "source": "/industries/furniture", "destination": "/services", "statusCode": 301 },
    { "source": "/book-demo", "destination": "/contact", "statusCode": 301 },
    { "source": "/index.html", "destination": "/", "statusCode": 301 }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/thank-you",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/404",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/(robots.txt|sitemap.xml|site.webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    }
  ]
}
